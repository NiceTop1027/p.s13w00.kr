# === Phishing SMS Analyzer - Configuration ===
# Copy this file to .env and adjust as needed.
# For local dev: just having this file + `npm run dev` is enough (dotenv loads it).
# For Docker: pass --env-file .env or use docker-compose.

PORT=5173
NODE_ENV=development

# === Ollama (local LLM) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_MS=8000

# === Threat Intelligence ===
# Set to "false" to disable external URLhaus lookup (still works fully locally)
URLHAUS_LOOKUP=true

# === Optional future knobs (not all implemented yet) ===
# MAX_MESSAGE_CHARS=8000
# ENABLE_STRUCTURED_LOG=true
